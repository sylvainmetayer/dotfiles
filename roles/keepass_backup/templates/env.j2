# Managed by Ansible (roles/keepass_backup). Read by systemd (EnvironmentFile) and by bash (keepass-backup sources it).
# Values are single-quoted so both read them the same way; the restic password lives in its own file.
KEEPASS_BACKUP_SOURCE_DIR='{{ keepass_backup_source_dir }}'
KEEPASS_BACKUP_GLOB='{{ keepass_backup_glob }}'
KEEPASS_BACKUP_HISTORY_DIR='{{ keepass_backup_history_dir }}'
KEEPASS_BACKUP_HISTORY_KEEP_DAYS='{{ keepass_backup_history_keep_days }}'
KEEPASS_BACKUP_CHECK_DIR='{{ keepass_backup_check_dir }}'
KEEPASS_BACKUP_RESTIC_BIN='{{ keepass_backup_restic_bin }}'
KEEPASS_BACKUP_RESTIC_HOST='{{ keepass_backup_restic_host }}'
KEEPASS_BACKUP_RESTIC_TAG='{{ keepass_backup_restic_tag }}'
{% if keepass_backup_restic_configured %}
RESTIC_REPOSITORY='{{ keepass_backup_restic.repository }}'
RESTIC_PASSWORD_FILE='{{ keepass_backup_config_dir }}/restic-password'
AWS_ACCESS_KEY_ID='{{ keepass_backup_restic.access_key_id }}'
AWS_SECRET_ACCESS_KEY='{{ keepass_backup_restic.secret_access_key }}'
{% endif %}
