[Unit]
Description=KeePass databases backup, restic snapshot
# Managed by Ansible (roles/keepass_backup)
# Retries 10 min apart, one notification when the start limit refuses the next start (RestartMode=direct: an automatic
# restart skips the failed state, so OnFailure does not fire on it). The window is fixed (it opens at its first start)
# and the hourly successes count in it: a failure on its 1st, 2nd or 3rd hourly run gets 6, 5 or 4 attempts, alert 60,
# 50 or 40 min later; on a 4th run just before the window closes, the retries open a new one (alert ~70 min). Starts
# refused inside the window (the next hourly timer runs) are silent: a persistent failure notifies about every 3 h.
# TimeoutStartSec bounds a failing run, so that the 7th start always falls inside the window (6 x (15 + 10) min < 3 h):
# a slower or hung run would push the retries past it and they would go on forever without a notification.
OnFailure=keepass-backup-notify@%n.service
StartLimitIntervalSec=3h
StartLimitBurst=6

[Service]
Type=oneshot
EnvironmentFile={{ keepass_backup_config_dir }}/env
# A user unit cannot order itself after network-online.target (system manager): wait up to 2 min for
# NetworkManager instead. Still offline: the run is skipped (not failed, no notification), the hourly timer retries.
ExecCondition=/usr/bin/nm-online --quiet --timeout=120
ExecStart={{ keepass_backup_bin_dir }}/keepass-backup run
Nice=10
IOSchedulingClass=idle
# A real failure (S3 error, lock): retry instead of waiting for the next timer.
Restart=on-failure
RestartMode=direct
RestartSec=10min
TimeoutStartSec=15min
