[Unit]
Description=KeePass databases backup, local timestamped copies
# Managed by Ansible (roles/keepass_backup)
OnFailure=keepass-backup-notify@%n.service

[Service]
Type=oneshot
EnvironmentFile={{ keepass_backup_config_dir }}/env
ExecStart={{ keepass_backup_bin_dir }}/keepass-backup local
Nice=10
IOSchedulingClass=idle
