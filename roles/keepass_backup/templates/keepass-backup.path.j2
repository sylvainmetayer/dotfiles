[Unit]
Description=Copy the KeePass databases as soon as one changes
# Managed by Ansible (roles/keepass_backup)

[Path]
PathChanged={{ keepass_backup_source_dir }}
Unit=keepass-backup-local.service
# Default trigger limits (200 per 2 s) only guard against loops: the script itself waits for the writes to settle.

[Install]
WantedBy=default.target
