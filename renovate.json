{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":pinDevDependencies",
    "docker:pinDigests",
    "helpers:pinGitHubActionDigests"
  ],
  "assignees": [
    "sylvainmetayer"
  ],
  "addLabels": [
    "dependencies"
  ],
  "customManagers": [
    {
      "managerFilePatterns": [
        "**/*.yaml"
      ],
      "customType": "regex",
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[a-z-]+) depName=(?<depName>[^\\n]+?)(?:\\s+extractVersion=(?<extractVersion>[^\\n]+?))?\\n\\s+generic_app_url: \\\"[^\\\"]*?[-/]v?(?<currentValue>[0-9]+(?:\\.[0-9]+)+)[-/\\\"]",
        "# renovate: datasource=(?<datasource>[a-z-]+) depName=(?<depName>[^\\n]+?)(?:\\s+extractVersion=(?<extractVersion>[^\\n]+?))?\\n\\s+generic_app_url: \\\"[^\\\"]*?[-/]v?[0-9]+(?:\\.[0-9]+)+[-/][^\\\"]*?[-/]v?(?<currentValue>[0-9]+(?:\\.[0-9]+)+)[.\\-/\\\"]"
      ]
    },
    {
      "managerFilePatterns": [
        "roles/kdrive/defaults/main.yaml"
      ],
      "customType": "regex",
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[a-z-]+) depName=(?<depName>\\S+) currentValue=(?<currentValue>\\S+)\\n\\s*kdrive_auto_update_ref: \"(?<currentDigest>[a-f0-9]{40})\""
      ]
    },
    {
      "managerFilePatterns": [
        "roles/*/defaults/main.yaml"
      ],
      "customType": "regex",
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[a-z-]+) depName=(?<depName>\\S+?)(?:\\s+extractVersion=(?<extractVersion>[^\\n]+?))?\\n\\s*[a-z_]+_version: \"(?<currentValue>[0-9]+(?:\\.[0-9]+)+)\""
      ]
    }
  ]
}
