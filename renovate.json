{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":pinDevDependencies",
    "docker:pinDigests",
    "helpers:pinGitHubActionDigests"
  ],
  "assignees": [
    "sylvainmetayer"
  ],
  "addLabels": [
    "dependencies"
  ],
  "customManagers": [
    {
      "managerFilePatterns": [
        "**/*.yaml"
      ],
      "customType": "regex",
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[a-z-]+) depName=(?<depName>[^\\n]+?)(?:\\s+extractVersion=(?<extractVersion>[^\\n]+?))?\\n\\s+generic_app_url: \\\"[^\\\"]*?[-/]v?(?<currentValue>[0-9]+(?:\\.[0-9]+)+)[-/\\\"]",
        "# renovate: datasource=(?<datasource>[a-z-]+) depName=(?<depName>[^\\n]+?)(?:\\s+extractVersion=(?<extractVersion>[^\\n]+?))?\\n\\s+generic_app_url: \\\"[^\\\"]*?[-/]v?[0-9]+(?:\\.[0-9]+)+[-/][^\\\"]*?[-/]v?(?<currentValue>[0-9]+(?:\\.[0-9]+)+)[.\\-/\\\"]"
      ]
    },
    {
      "managerFilePatterns": [
        "roles/kdrive/defaults/main.yaml"
      ],
      "customType": "regex",
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[a-z-]+) depName=(?<depName>\\S+) currentValue=(?<currentValue>\\S+)\\n\\s*kdrive_auto_update_ref: \"(?<currentDigest>[a-f0-9]{40})\""
      ]
    },
    {
      "managerFilePatterns": [
        "roles/jetbrains_toolbox/defaults/main.yaml"
      ],
      "customType": "regex",
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[a-z.-]+) depName=(?<depName>\\S+)\\n\\s*jetbrains_toolbox_url: \"[^\"]*?-(?<currentValue>[0-9]+(?:\\.[0-9]+)+)\\.tar\\.gz\""
      ],
      "versioningTemplate": "loose"
    },
    {
      "managerFilePatterns": [
        "roles/git_credential_keepassxc/defaults/main.yaml"
      ],
      "customType": "regex",
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[a-z-]+) depName=(?<depName>\\S+)\\n\\s*git_credential_keepassxc_version: \"(?<currentValue>[^\"]+)\""
      ],
      "versioningTemplate": "semver"
    },
    {
      "managerFilePatterns": [
        ".github/workflows/*.yml"
      ],
      "customType": "regex",
      "matchStrings": [
        "pip install [^\\n]*?\\buv==(?<currentValue>[0-9][^\\s]*)"
      ],
      "datasourceTemplate": "pypi",
      "depNameTemplate": "uv"
    }
  ],
  "customDatasources": {
    "jetbrains-toolbox": {
      "defaultRegistryUrlTemplate": "https://data.services.jetbrains.com/products/releases?code=TBA&latest=true&type=release",
      "transformTemplates": [
        "{\"releases\": [{\"version\": $.TBA[0].build}]}"
      ]
    }
  },
  "packageRules": [
    {
      "description": "uv de mise.toml et des workflows dans la même PR, pour que la CI lise uv.lock avec la version locale",
      "matchDepNames": [
        "uv"
      ],
      "groupName": "uv"
    }
  ]
}
